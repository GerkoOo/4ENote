<?xml version="1.0" encoding="utf-8"?>
<!-- The WebDAV password and the Google sign-in stay on this device: it is not part of cloud backups. -->
<full-backup-content>
    <exclude domain="sharedpref" path="webdav.xml" />
    <exclude domain="sharedpref" path="google-auth.xml" />
</full-backup-content>
