<?xml version="1.0" encoding="utf-8"?>
<!-- Notes stay out of Android backups: locked ones are not encrypted on the device, and the
     4ENote backup and cloud sync are the way to move notes. The WebDAV password and the Google sign-in stay on this device too: they are not part of cloud backups. -->
<full-backup-content>
    <exclude domain="sharedpref" path="webdav.xml" />
    <exclude domain="sharedpref" path="google-auth.xml" />
    <exclude domain="sharedpref" path="app-password.xml" />
    <exclude domain="sharedpref" path="notes-key.xml" />
    <exclude domain="sharedpref" path="device-key.xml" />
    <exclude domain="sharedpref" path="device-id.xml" />
    <exclude domain="file" path="ink" />
    <exclude domain="file" path="attachments" />
    <exclude domain="file" path="inbox" />
    <exclude domain="file" path="test-cloud" />
    <exclude domain="file" path="crash-log.txt" />
    <exclude domain="database" path="4enote.db" />
    <exclude domain="database" path="4enote.db-wal" />
    <exclude domain="database" path="4enote.db-shm" />
</full-backup-content>
