<?xml version="1.0" encoding="utf-8"?>
<!-- The WebDAV password stays on this device: it is not backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="webdav.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="webdav.xml" />
    </device-transfer>
</data-extraction-rules>
