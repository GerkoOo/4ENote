<?xml version="1.0" encoding="utf-8"?>
<!-- The WebDAV password and the Google sign-in stay on this device: it is not backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="webdav.xml" />
        <exclude domain="sharedpref" path="google-auth.xml" />
        <exclude domain="sharedpref" path="app-password.xml" />
        <exclude domain="sharedpref" path="notes-key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="webdav.xml" />
        <exclude domain="sharedpref" path="google-auth.xml" />
        <exclude domain="sharedpref" path="app-password.xml" />
        <exclude domain="sharedpref" path="notes-key.xml" />
    </device-transfer>
</data-extraction-rules>
